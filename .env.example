# Copy to .env and fill in to enable the real Anthropic backend.
# Left unset, the gateway runs fully offline via the deterministic MockProvider.

# Anthropic API key (required only for the AnthropicProvider / model "claude-sonnet-5").
ANTHROPIC_API_KEY=

# Optional server bind settings for `uvicorn aigateway.main:app`.
HOST=0.0.0.0
PORT=8000
